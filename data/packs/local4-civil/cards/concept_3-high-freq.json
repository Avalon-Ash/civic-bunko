      "hook": "行政行為除了守法條，還要守這幾條原則。",
      "visual": {
        "kind": "flow",
        "lanes": [
          {
            "steps": [
              { "text": "有助目的", "tone": "plain" },
              { "text": "損害最少", "tone": "plain" },
              { "text": "不失衡", "tone": "key" }
            ]
          }
        ]
      },
      "faces": [
        {
          "heading": "依法行政",
          "lines": [
            "行政行為受法律與一般法律原則拘束",
            "法律優位：不能牴觸法律",
            "法律保留：重要事項要有法律依據"
          ]
        },
        {
          "heading": "比例原則三關",
          "lines": [
            "方法要有助於達成目的",
            "多種方法選損害最少的",
            "損害和利益不能顯失均衡"
          ]
        },
        {
          "heading": "平等與明確",
          "lines": [
            "沒有正當理由，不得差別待遇",
            "行政行為的內容要明確"
          ]
        },
        {
          "heading": "誠信與信賴保護",
          "lines": [
            "用誠實信用的方法",
            "保護人民正當合理的信賴",
            "對當事人有利、不利的情形一律注意"
          ]
        },
        {
          "heading": "裁量的界線",
          "lines": [
            "不得逾越法定的裁量範圍",
            "要符合法規授權的目的"
          ]
        }

                "via": "不服時",
                "text": "先訴願",
                "children": [
                  {
                    "via": "仍不服",
                    "text": "再打行政訴訟"
                  }
                ]
              }
            ]
          },
          {
            "text": "法規命令",
            "note": "法律授權，一般事項抽象規定"
          }
        ]
      },
      "faces": [

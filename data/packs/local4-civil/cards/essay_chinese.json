      },
      "faces": [
        { "heading": "短文：三因素", "lines": ["同情心：虎鯨母子的處境令人不忍", "罪惡感：是人類的娛樂造成牠們的痛苦", "正義感：憤怒業者與政府的失責"] },
        { "heading": "短文：提醒", "lines": ["至少寫三點：每點一句原因、一句說明", "限 400 字，引用文章裡的畫面"] },
        { "heading": "作文：破題", "lines": ["善意沒有規劃，可能變成殘忍", "兩個案例的共同問題：缺少配套"] },
        { "heading": "作文：分析", "lines": ["虎鯨：只禁演，沒有安置與強制手段", "AFDC：沒有期限與誘因設計，養成依賴", "應注意：事前評估、配套、退場與檢討"] },
        { "heading": "作文：結論", "lines": ["好政策要有善意，也要有周延的規劃", "扣回公務：執行前先想清楚後果"] }

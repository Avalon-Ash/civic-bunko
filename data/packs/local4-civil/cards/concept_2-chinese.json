                    "text": "有隸屬稱「鈞」"
                  },
                  {
                    "text": "無隸屬稱「大」",
                    "tone": "hot"
                  }
                ]
              },
              {
                "text": "平行文",
                "note": "稱「貴」；請查照、見復"
              },
              {
                "text": "下行文",
                "note": "稱「貴」；希查照、希照辦"
              }
            ]
          }
        ]
      },
      "faces": [
        { "heading": "公文六類", "lines": ["令、呈、咨、函、公告、其他公文", "呈：對總統有所呈請或報告", "咨：總統與立法院、監察院往復"] },
        { "heading": "函最常用", "lines": ["各機關之間公文往復用函", "人民與機關的申請、答復也用函", "結構三段：主旨、說明、辦法"] },
        { "heading": "稱謂", "lines": ["有隸屬：下對上稱「鈞」、上對下稱「貴」", "無隸屬：對上級稱「大」、平行稱「貴」", "自稱「本」；對人民稱「台端」"] },

      "title": "作文四段寫法",
      "hook": "起、承、轉、合：破題、舉例、反思、收束。",
      "visual": {
        "kind": "table",
        "corner": "階段",
        "columns": [
          "做什麼",
          "寫法提示"
        ],
        "rows": [
          {
            "head": "動筆前",
            "cells": [
              "花 5 分鐘列大綱",
              "工整、分段、不離題"
            ]
          },
          {
            "head": "起：破題",
            "cells": [
              "前兩三句表明立場",
              "定義、名言或畫面開頭"
            ]
          },
          {
            "head": "承：舉例",
            "cells": [
              "一到兩個具體例子",
              "個人經驗加時事或公務"
            ]
          },
          {
            "head": "轉：反思",
            "cells": [
              "困難、反例或限制",
              "說明如何克服更完整"
            ]
          },
          {
            "head": "合：結論",
            "cells": [
              "回扣題目重申看法",
              "拉到公務角色或期許"
            ]
          }
        ]
      },
      "faces": [
        { "heading": "起：破題", "lines": ["前兩三句就回應題目，表明立場", "可以用定義、名言或一個畫面開頭"] },
        { "heading": "承：舉例", "lines": ["用一到兩個具體例子支持論點", "個人經驗加上時事或公務情境最穩"] },
        { "heading": "轉：反思", "lines": ["換個角度：困難、反例或限制", "說明怎麼克服，讓論點更完整"] },
        { "heading": "合：結論", "lines": ["回扣題目，重申核心看法", "拉到公務員的角色或未來期許"] },
        { "heading": "動筆前", "lines": ["先花 5 分鐘列大綱再寫", "字跡工整、分段清楚、不離題"] }

    {
      "id": "concept-zh-reading",
      "kind": "concept",
      "subjectKey": "chinese",
      "title": "閱讀題解題步驟",
      "hook": "先看題目問什麼，再回文章找證據。",
      "visual": {
        "kind": "tree",
        "roots": [
          {
            "text": "1. 先看題幹",
            "note": "先讀題目與選項",
            "children": [
              {
                "text": "圈關鍵字",
                "note": "「不」「錯誤」「最」",
                "tone": "hot"
              }
            ]
          },
          {
            "text": "2. 找主旨",
            "note": "首段、末段、轉折之後",
            "children": [
              {
                "text": "看「然而」「但」「其實」後"
              }
            ]
          },
          {
            "text": "3. 刪去法",
            "children": [
              {
                "text": "先刪與文意相反的"
              },
              {
                "text": "小心太絕對、過度推論",
                "note": "「都」「一定」、文中沒提",
                "tone": "hot"
              }
            ]
          },
          {
            "text": "文言文怎麼看",
            "children": [
              {
                "text": "先看注釋與題目",
                "note": "抓人物與事件"
              },
              {
                "text": "不懂先跳過，看上下文推"
              }
            ]
          }
        ]
      },
      "faces": [
        { "heading": "先看題幹", "lines": ["先讀題目與選項，知道要找什麼", "圈出「不」「錯誤」「最」等關鍵字"] },
        { "heading": "找主旨", "lines": ["主旨常在首段、末段或轉折之後", "注意「然而」「但」「其實」後面的話"] },
        { "heading": "刪去法", "lines": ["說得太絕對（都、一定）的要小心", "文章沒提到的推論不要選", "和文章意思相反的先刪掉"] },
        { "heading": "文言文", "lines": ["先看注釋與題目，抓人物與事件", "不懂的字先跳過，看上下文推意思"] }
